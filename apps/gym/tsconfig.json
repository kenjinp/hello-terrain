{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "@webgpu/types"],
    "paths": {
      "@hello-terrain/three": ["../../packages/three/src/index.ts"],
      "@hello-terrain/react": ["../../packages/react/src/index.tsx"],
      "@hello-terrain/work": ["../../packages/work/src/index.ts"]
    }
  },
  "include": ["*.ts", "src", "../../packages/three/gym"]
}
