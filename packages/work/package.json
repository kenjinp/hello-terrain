{
  "name": "@hello-terrain/work",
  "description": "A small reactive task graph library for scheduling dependent computations.",
  "version": "0.3.0",
  "homepage": "http://hello-terrain.kenny.wtf/work",
  "repository": {
    "type": "git",
    "url": "https://github.com/kenjinp/hello-terrain.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "release": "pnpm run build && pnpm publish --access=public",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit --composite false",
    "bench": "npx tsx benchmarks/Graph.bench.ts",
    "lint": "oxlint -c node_modules/@config/oxlint/base.json",
    "format": "oxfmt -c node_modules/@config/oxfmt/base.json --write ."
  },
  "dependencies": {
    "eventery": "^0.0.4"
  },
  "devDependencies": {
    "@config/oxfmt": "workspace:*",
    "@config/oxlint": "workspace:*",
    "@config/typescript": "workspace:*",
    "mitata": "^1.0.34",
    "unbuild": "^3.5.0",
    "vitest": "^4.0.0"
  }
}
