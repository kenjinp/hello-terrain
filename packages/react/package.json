{
  "name": "@hello-terrain/react",
  "description": "High performance terrain system for three.js and react-three/fiber",
  "homepage": "http://hello-terrain.kenny.wtf",
  "repository": {
    "type": "git",
    "url": "https://github.com/kenjinp/hello-terrain.git"
  },
  "version": "0.0.0-alpha.10",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "release": "pnpm run build && pnpm publish --access=public",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit --composite false",
    "lint": "oxlint -c node_modules/@config/oxlint/react.json",
    "format": "oxfmt -c node_modules/@config/oxfmt/base.json --write ."
  },
  "dependencies": {
    "@hello-terrain/three": "workspace:*",
    "@hello-terrain/work": "workspace:*"
  },
  "devDependencies": {
    "@config/oxfmt": "workspace:*",
    "@config/oxlint": "workspace:*",
    "@config/typescript": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "catalog:",
    "jsdom": "^26.0.0",
    "unbuild": "^3.5.0",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "@react-three/fiber": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "three": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
