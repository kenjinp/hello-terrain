{
	"oxc.enable": true,
	"eslint.enable": false,
	"biome.enabled": false,
	"editor.defaultFormatter": "oxc.oxc-vscode",
	"editor.codeActionsOnSave": {
		"source.removeUnusedImports": "explicit"
	},
	"[json]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"cursor.terminal.allowedCommands": [
		"beans",
		"beans *"
	]
}
