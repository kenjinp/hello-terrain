{
  "name": "hello-terrain",
  "version": "0.0.0-alpha.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter './apps/*' run dev",
    "build": "pnpm --filter './packages/*' run build && pnpm --filter './apps/*' run build",
    "test": "pnpm -r run test",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "commit": "gitmoji -c"
  },
  "devDependencies": {
    "@config/typescript": "workspace:*",
    "gitmoji-cli": "^9.7.0",
    "oxfmt": "^0.21.0",
    "oxlint": "^1.36.0"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "pnpm": ">=10.0.0",
    "node": ">=24.0.0"
  },
  "references": [
    {
      "path": "./packages/hello-terrain/three"
    },
    {
      "path": "./packages/hello-terrain/react"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}